# See also Dockerfile; the PHP set up should be the same
FROM public.ecr.aws/docker/library/php:8.4.23-cli

RUN apt-get update && apt-get install -y libpng-dev nano wget
RUN docker-php-ext-install mysqli pcntl gd

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
# Later directives override earlier ones, so add overrides at the end
RUN cat <<EOF >> "$PHP_INI_DIR/php.ini"
max_input_vars = 3000
# Let PHP take all the memory in the task
memory_limit = -1
# Do not expose PHP
expose_php = Off
include_path = ".:/var/www/lib"
date.timezone = "America/New_York"
# Session data
session.name = "Techscore"
session.cookie_httponly = On
session.cookie_secure = On
session.cookie_path = "/"
session.cookie_domain = ""
session.cookie_samesite = "Strict"
session.cookie_lifetime = 0
EOF

RUN pecl install pcov && docker-php-ext-enable pcov
RUN cat <<EOF >> "$PHP_INI_DIR/php.ini"
pcov.enabled = On
EOF

COPY lib /var/www/lib

WORKDIR /var/www

RUN cat <<EOF >> phpunit.xml
<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://w3.org"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">

    <testsuites>
        <testsuite name="unit">
            <directory>tst/unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">lib</directory>
        </include>
    </source>

</phpunit>
EOF

RUN wget -O phpunit https://phar.phpunit.de/phpunit-13.phar
RUN chmod +x phpunit

CMD ["./tst/unit"]
ENTRYPOINT ["./phpunit", "--bootstrap", "./tst/conf.php", "--log-junit", "./tst/results.xml", "--coverage-html", "./tst/coverage"]
